<?xml version="1.0" encoding="UTF-8"?>
<extentreports>
    <configuration>
        <reportName>UI Automation Report</reportName>
        <documentTitle>Selenium UI Test Automation Results</documentTitle>
        <encoding>utf-8</encoding>
        <theme>standard</theme>
        <protocol>https</protocol>
        <timelineEnabled>true</timelineEnabled>
        <charts>
            <enable>true</enable>
            <type>pie</type>
        </charts>
        <testsView>expanded</testsView>
        <dashboardView>expanded</dashboardView>
        <retryTestCount>0</retryTestCount>
        <offlineMode>true</offlineMode>
        <timestampFormat>MMM dd, yyyy HH:mm:ss</timestampFormat>
        <customStyles>
            <![CDATA[
                .test-status.pass { background-color: #e8f5e9; }
                .test-status.fail { background-color: #ffebee; }
            ]]>
        </customStyles>
        <customScripts>
            <![CDATA[
                // Add any custom JavaScript here
            ]]>
        </customScripts>
    </configuration>
</extentreports>
